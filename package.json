    "chai-as-promised": "^7.1.1",
    "husky": "^5.1.3",
    "mocha": "^9.0.0",
    "nyc": "^15.0.0",
    "prettier": "^2.2.1",
    "pretty-quick": "^3.0.0",
    "sinon": "^10.0.1",
    "ts-json-schema-generator": "^0.56.0",
    "ts-node": "^10.0.0",
    "tslint": "^6.1.3",
