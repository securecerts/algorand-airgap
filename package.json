  "dependencies": {
    "@airgap/crypto": "^0.13.35",
    "@airgap/module-kit": "^0.13.27",
    "algosdk": "^2.8.0",
    "axios": "^0.20.0",
    "bs58": "^6.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/chai": "^4.2.0",
    "@types/chai-as-promised": "^7.1.0",
